    def load_data(self):
        """Original single file loading"""
        file_path, _ = QFileDialog.getOpenFileName(
            self,
            'Select .continuous file',
            filter="Continuous files (*.continuous)"
        )
        
        if not file_path:
            return
        
        try:
            # Check if it's a continuous file
            if 'continuous' not in file_path:
                print(f"Error: {file_path} is not a .continuous file")
                QMessageBox.warning(self, "Invalid File", "Please select a .continuous file")
                return
            
            # Use the Open Ephys loader
            result = loadContinuous(file_path, dtype=float, verbose=True)
            data = result['data']
            timestamps = result['timestamps']
            header = result['header']
            
            print(f"\nLoaded {len(data)} samples")
            print(f"Sample rate: {header.get('sampleRate', 'Unknown')} Hz")
            print(f"Bit volts: {header.get('bitVolts', 'Unknown')} µV/bit")
            
            if len(data) == 0:
                print("No data found in file")
                return
            
            self.plot_manager.plot_data(data, timestamps, header, file_path)
            
        except Exception as e:
            print("Error loading file:", str(e))
            traceback.print_exc()

